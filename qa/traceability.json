{
  "schema_version": 1,
  "release": "1.0.0",
  "owner": "Accounting Agent QA",
  "user_stories": [
    {
      "id": "QA-US-001",
      "persona": "Small-firm accountant",
      "need": "Run a controlled synthetic intake and understand which work is ready or blocked.",
      "acceptance_criteria": ["Intake stays client-scoped", "Guided copy is understandable", "No external system is contacted"],
      "test_evidence": ["tests/test_microsoft365_intake.py", "tests/test_operations_cockpit.py"]
    },
    {
      "id": "QA-US-002",
      "persona": "Accountant",
      "need": "Prepare supplier-invoice accounting while duplicates, unknown suppliers, bank changes, uncertain VAT, and locked periods stop safely.",
      "acceptance_criteria": ["Normal synthetic invoices produce drafts", "Every defined risk reaches human review or a stricter stop", "No final posting occurs"],
      "test_evidence": ["tests/test_supplier_invoice_pipeline.py", "tests/test_openclaw_risk_review.py"]
    },
    {
      "id": "QA-US-003",
      "persona": "Accountant",
      "need": "Reconcile exact, partial, duplicate-looking, fee, large unknown, and unmatched bank transactions without double consumption.",
      "acceptance_criteria": ["Candidate scoring is deterministic", "One target cannot be consumed twice", "Ambiguity produces review evidence"],
      "test_evidence": ["tests/test_bank_reconciliation_autopilot.py", "tests/test_locale_and_reconciliation_safety.py"]
    },
    {
      "id": "QA-US-004",
      "persona": "Senior accountant and financial controller",
      "need": "Review escalations, enforce segregation of duties, and assess period-close readiness without allowing the agent to lock a period.",
      "acceptance_criteria": ["Approval and permit scopes match exactly", "Preparer and reviewer identities differ", "Close ends at a human decision"],
      "test_evidence": ["tests/test_permit_approval_bridge_v1.py", "tests/test_close_v1.py"]
    },
    {
      "id": "QA-US-005",
      "persona": "Auditor",
      "need": "Verify source provenance, immutable decisions, evidence hashes, and tamper detection across exact client and entity scopes.",
      "acceptance_criteria": ["Hash-chain mutation is detected", "Cross-entity reuse is rejected", "Audit evidence is append-only"],
      "test_evidence": ["tests/test_evidence_approvals_v1.py", "tests/test_repository_safety.py"]
    },
    {
      "id": "QA-US-006",
      "persona": "Agent operator",
      "need": "Run bounded preparation with checkpoint, resume, cancellation, lease recovery, and independent review.",
      "acceptance_criteria": ["Completed stages do not repeat", "Cancellation wins", "Terminal state is awaiting human decision"],
      "test_evidence": ["tests/test_autonomy_v1.py", "tests/test_v1_integration.py"]
    },
    {
      "id": "QA-US-007",
      "persona": "ERP integrator",
      "need": "Evaluate Fortnox, NetSuite, Oracle, SAP, Odoo, SIE, and CSV through one fail-closed connector contract.",
      "acceptance_criteria": ["Tenant, entity, environment, schema, cursor, and source hash remain bound", "Only guarded Fortnox reads are implemented", "External writes remain forbidden"],
      "test_evidence": ["tests/test_connector_contract_v1.py", "tests/test_fortnox_adapter.py", "tests/test_restricted_fortnox_mcp.py"]
    },
    {
      "id": "QA-US-008",
      "persona": "Model operator",
      "need": "Use deterministic or local advisory models without exposing credentials or granting execution authority.",
      "acceptance_criteria": ["Confidential data routes locally", "Hosted and Codex providers stay disabled by default", "Model output cannot approve or execute"],
      "test_evidence": ["tests/test_model_runtime_v1.py", "tests/test_autonomy_v1.py"]
    },
    {
      "id": "QA-US-009",
      "persona": "International accountant",
      "need": "Represent currencies, locale-specific amounts, FX evidence, and jurisdiction packs without pretending unsupported tax compliance.",
      "acceptance_criteria": ["Zero, two, and three-decimal currencies round correctly", "FX is evidence-bound", "Unknown precision and unsupported compliance fail closed"],
      "test_evidence": ["tests/test_money_and_journal_v1.py", "tests/test_locale_and_reconciliation_safety.py", "tests/test_platform_foundation.py"]
    },
    {
      "id": "QA-US-010",
      "persona": "Public preview viewer",
      "need": "Inspect a useful synthetic demonstration without local files, private course material, secrets, or external authority.",
      "acceptance_criteria": ["Bundle contains exactly the allowed files", "No local source link or private marker is present", "Runtime requests stay inside the preview bundle"],
      "test_evidence": ["tests/test_operations_cockpit.py", "tests/ui/cockpit-boundaries.spec.ts"]
    },
    {
      "id": "QA-US-011",
      "persona": "Beginner and professional user",
      "need": "Use English or Swedish, Guided or Expert detail, and any role perspective with accessible keyboard behavior.",
      "acceptance_criteria": ["All 24 locale, mode, and role combinations preserve safety truth", "Keyboard and focus flows complete", "WCAG 2.2 A and AA automated checks have no violations"],
      "test_evidence": ["tests/ui/cockpit-matrix.spec.ts", "tests/ui/cockpit-accessibility.spec.ts", "tests/ui/cockpit-interactions.spec.ts", "docs/qa/accessibility-checklist.md"]
    },
    {
      "id": "QA-US-012",
      "persona": "Adversarial caller and failure operator",
      "need": "Prove forged permits, replay, redirects, proxies, hostile paths, corrupted state, and concurrency cannot bypass accounting controls.",
      "acceptance_criteria": ["Invalid preflight performs zero network calls", "Duplicate permit IDs never replace trusted records", "Crash and concurrency recovery preserve scope and integrity"],
      "test_evidence": ["tests/test_policy_and_permits.py", "tests/test_permit_approval_bridge_v1.py", "tests/test_fortnox_adapter.py", "tests/test_autonomy_v1.py"]
    },
    {
      "id": "QA-US-013",
      "persona": "Archive administrator and auditor",
      "need": "Preserve typed document provenance, processing lineage, retention, legal holds, and signatures across exact tenant and entity scope without storing raw document data in control records.",
      "acceptance_criteria": ["Every top-level wire envelope is immutable and versioned", "Unknown classifications and incomplete archive evidence fail closed", "Retention cannot shorten and active legal holds cannot disappear"],
      "test_evidence": ["tests/test_production_contracts_scope_archive.py"]
    },
    {
      "id": "QA-US-014",
      "persona": "Agent operator and draft-gateway integrator",
      "need": "Reserve each exact provider draft attempt durably so replay, crash recovery, ambiguity, and concurrent workers cannot duplicate or re-scope an external action.",
      "acceptance_criteria": ["Every idempotency key is atomically bound to an immutable execution scope", "Completed and unknown outcomes are terminal and tamper-resistant", "Ambiguous outcomes require human review and never retry automatically"],
      "test_evidence": ["tests/test_execution_attempts.py"]
    },
    {
      "id": "QA-US-015",
      "persona": "Accountant, controller, and auditor",
      "need": "Exchange typed supplier, invoice, journal, balance, period, and dimension facts with exact scope and source provenance instead of arbitrary connector mappings.",
      "acceptance_criteria": ["Money stays in the cross-language interoperable integer range and journals balance", "Locked periods and terminal lifecycle states cannot silently regress or reactivate", "Bank data is fingerprint-only and provenance binds the exact sync evidence"],
      "test_evidence": ["tests/test_production_contracts_canonical.py"]
    },
    {
      "id": "QA-US-016",
      "persona": "Connector operator and enterprise controller",
      "need": "Run read-only connector synchronization with exact environment, cursor, snapshot, canonical-record, and source-reconciliation evidence.",
      "acceptance_criteria": ["Write capabilities are structurally rejected", "Checkpoint chains are ordered and cursor-continuous", "A run completes only when every requested source count and hash reconciles"],
      "test_evidence": ["tests/test_production_contracts_sync.py"]
    },
    {
      "id": "QA-US-017",
      "persona": "Independent reviewer and draft-gateway operator",
      "need": "Record authenticated approval decisions and exact supplier-invoice draft envelopes without granting posting authority or retrying ambiguous outcomes.",
      "acceptance_criteria": ["Self-review and weak authentication are rejected", "Drafts bind policy, approval receipt, approval decision, permit, evidence, connection, and payload hashes", "Only an exact read-back of an unbooked reversible draft avoids a connection freeze"],
      "test_evidence": ["tests/test_production_contracts_commands.py"]
    },
    {
      "id": "QA-US-018",
      "persona": "Tenant model administrator and security reviewer",
      "need": "Qualify one advisory model provider with explicit data, region, retention, redaction, consent, evaluation, and budget limits and no silent fallback.",
      "acceptance_criteria": ["Credentials never route to a model and private course data stays local", "Hosted sensitive data requires reviewed provider evidence and redaction", "Consent changes require a later timestamp and new authenticated evidence", "Policy successors can only narrow capability and no model can approve or execute", "Cross-language consumers reproduce the exact canonical hash vectors"],
      "test_evidence": ["tests/test_production_contracts_model.py", "tests/test_production_contract_vectors.py"]
    }
  ],
